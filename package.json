{
  "name": "nibblearn",
  "version": "0.1.0",
  "description": "Goal-driven learning notes from video subtitles; Pi adapter available, DSH planned",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "bilibili", "learning", "markdown"],
  "engines": { "node": ">=24.0.0" },
  "files": ["extensions", "src", "vendor", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "pi": { "extensions": ["./extensions/index.ts"] },
  "scripts": {
    "start": "pi -e ./extensions/index.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <2",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
